<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Kehadiran karyawan. -->
    <record id="view_cloudlaundry_attendance_tree" model="ir.ui.view">
        <field name="name">cloudlaundry.attendance.tree</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <tree string="Kehadiran Karyawan">
                <field name="employee_id"/>
                <field name="x_id_cabang"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours"/>
            </tree>
        </field>
    </record>

    <record id="view_cloudlaundry_attendance_form" model="ir.ui.view">
        <field name="name">cloudlaundry.attendance.form</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <form string="Kehadiran">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="x_id_cabang"/>
                        <field name="check_in"/>
                        <field name="check_out"/>
                        <field name="worked_hours" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cloudlaundry_attendance" model="ir.actions.act_window">
        <field name="name">Check In dan Check Out</field>
        <field name="res_model">hr.attendance</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_cloudlaundry_attendance_tree"/>
    </record>

</odoo>
