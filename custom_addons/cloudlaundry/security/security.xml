<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Kategori Hak Akses CloudLaundry -->
        <record id="module_category_cloudlaundry" model="ir.module.category">
            <field name="name">CloudLaundry Management</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_cloudlaundry_owner" model="res.groups">
            <field name="name">Owner</field>
            <field name="category_id" ref="module_category_cloudlaundry"/>
            <field name="comment">Sponsor, pemasaran, arah ekspansi, baca dasbor eksekutif.</field>
        </record>

        <record id="group_cloudlaundry_area_manager" model="res.groups">
            <field name="name">Area Manager</field>
            <field name="category_id" ref="module_category_cloudlaundry"/>
            <field name="comment">Quality control lintas cabang, terima eskalasi komplain.</field>
        </record>

        <record id="group_cloudlaundry_kepala_store" model="res.groups">
            <field name="name">Kepala Store</field>
            <field name="category_id" ref="module_category_cloudlaundry"/>
            <field name="comment">Operasional cabang, bagi tugas harian, cek stok mingguan.</field>
        </record>

        <record id="group_cloudlaundry_hr" model="res.groups">
            <field name="name">HR</field>
            <field name="category_id" ref="module_category_cloudlaundry"/>
            <field name="comment">Gaji dan insentif, SOP, rekap kehadiran.</field>
        </record>

        <record id="group_cloudlaundry_finance" model="res.groups">
            <field name="name">Finance</field>
            <field name="category_id" ref="module_category_cloudlaundry"/>
            <field name="comment">Keuangan, stok, supplier, pembelian.</field>
        </record>

        <record id="group_cloudlaundry_admin" model="res.groups">
            <field name="name">Admin</field>
            <field name="category_id" ref="module_category_cloudlaundry"/>
            <field name="comment">Layani pelanggan, catat pesanan, tagihan, komplain.</field>
        </record>

        <record id="group_cloudlaundry_staf_operasional" model="res.groups">
            <field name="name">Staf Operasional</field>
            <field name="category_id" ref="module_category_cloudlaundry"/>
            <field name="comment">Timbang, foto, cuci, kering, setrika, kemas.</field>
        </record>

        <record id="group_cloudlaundry_kurir" model="res.groups">
            <field name="name">Kurir</field>
            <field name="category_id" ref="module_category_cloudlaundry"/>
            <field name="comment">Jemput dan antar cucian pelanggan.</field>
        </record>

        <record id="group_cloudlaundry_admin_sistem" model="res.groups">
            <field name="name">Administrator Sistem</field>
            <field name="category_id" ref="module_category_cloudlaundry"/>
            <field name="comment">Kelola akun, hak akses, data master, cadangan sistem.</field>
        </record>

        <record id="rule_cloudlaundry_attendance_staf_own" model="ir.rule">
            <field name="name">CloudLaundry: staf operasional hanya melihat kehadiran sendiri</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cloudlaundry_staf_operasional'))]"/>
        </record>

        <record id="rule_cloudlaundry_attendance_kurir_own" model="ir.rule">
            <field name="name">CloudLaundry: kurir hanya melihat kehadiran sendiri</field>
            <field name="model_id" ref="hr_attendance.model_hr_attendance"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_cloudlaundry_kurir'))]"/>
        </record>
    </data>
</odoo>